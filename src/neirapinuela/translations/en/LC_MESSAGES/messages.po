#: src/neirapinuela/templates/apps/enablebanking/privacy.html:3
#: src/neirapinuela/templates/apps/enablebanking/privacy.html:9
msgid "Privacy Policy"
msgstr "Privacy Policy"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:12
#: src/neirapinuela/templates/apps/enablebanking/terms.html:12
msgid "Last updated"
msgstr "Last updated"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:17
msgid "Introduction"
msgstr "Introduction"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:19
msgid ""
"This is a personal, non-commercial application used exclusively by the "
"Neira Pinuela household. It connects to a bank account via the Enable "
"Banking API solely to view account information and balances."
msgstr ""
"This is a personal, non-commercial application used exclusively by the "
"Neira Pinuela household. It connects to a bank account via the Enable "
"Banking API solely to view account information and balances."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:26
msgid "Data we access"
msgstr "Data we access"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:28
msgid ""
"We request read-only access to your bank account information (account "
"list, balances, and transaction metadata) through the Enable Banking API."
msgstr ""
"We request read-only access to your bank account information (account "
"list, balances, and transaction metadata) through the Enable Banking API."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:35
msgid "What we do not do"
msgstr "What we do not do"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:37
msgid "We do not store bank credentials."
msgstr "We do not store bank credentials."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:38
msgid "We do not sell, share, or transfer your financial data to any third party."
msgstr "We do not sell, share, or transfer your financial data to any third party."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:39
msgid "We do not use your data for advertising or marketing."
msgstr "We do not use your data for advertising or marketing."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:46
msgid "Data storage"
msgstr "Data storage"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:48
msgid ""
"Access tokens are stored in a local SQLite database on our self-hosted "
"server. They are never transmitted to any external service other than "
"Enable Banking."
msgstr ""
"Access tokens are stored in a local SQLite database on our self-hosted "
"server. They are never transmitted to any external service other than "
"Enable Banking."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:55
msgid "Purpose"
msgstr "Purpose"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:57
msgid "Personal finance visualization and household budgeting."
msgstr "Personal finance visualization and household budgeting."

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:64
msgid "Your rights"
msgstr "Your rights"

#: src/neirapinuela/templates/apps/enablebanking/privacy.html:66
msgid ""
"You can revoke access at any time through your bank's online banking "
"portal or by contacting us."
msgstr ""
"You can revoke access at any time through your bank's online banking "
"portal or by contacting us."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:3
#: src/neirapinuela/templates/apps/enablebanking/terms.html:9
msgid "Terms of Service"
msgstr "Terms of Service"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:17
msgid "Scope"
msgstr "Scope"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:19
msgid ""
"This is a private, non-commercial tool used only by the Neira Pinuela "
"household (Oscar and Eva). It is not available to the public."
msgstr ""
"This is a private, non-commercial tool used only by the Neira Pinuela "
"household (Oscar and Eva). It is not available to the public."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:26
msgid "No warranty"
msgstr "No warranty"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:28
msgid ""
"This service is provided \"as is\" and \"as available,\" without any "
"warranty of any kind."
msgstr ""
"This service is provided \"as is\" and \"as available,\" without any "
"warranty of any kind."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:35
msgid "User responsibilities"
msgstr "User responsibilities"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:37
msgid ""
"Only authorized household members may connect a bank account. You are "
"responsible for keeping your login credentials secure."
msgstr ""
"Only authorized household members may connect a bank account. You are "
"responsible for keeping your login credentials secure."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:44
msgid "Third-party services"
msgstr "Third-party services"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:46
msgid ""
"Bank data is retrieved through Enable Banking, a third-party API "
"provider. Their terms of service also apply to your use of their "
"platform."
msgstr ""
"Bank data is retrieved through Enable Banking, a third-party API "
"provider. Their terms of service also apply to your use of their "
"platform."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:53
msgid "Limitation of liability"
msgstr "Limitation of liability"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:55
msgid ""
"The owners of this application are not liable for any damages arising "
"from the use or inability to use this service."
msgstr ""
"The owners of this application are not liable for any damages arising "
"from the use or inability to use this service."

#: src/neirapinuela/templates/apps/enablebanking/terms.html:62
msgid "Changes"
msgstr "Changes"

#: src/neirapinuela/templates/apps/enablebanking/terms.html:64
msgid ""
"We may update these terms at any time. Continued use constitutes "
"acceptance."
msgstr ""
"We may update these terms at any time. Continued use constitutes "
"acceptance."

